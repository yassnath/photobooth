{
  "name": "photobooth-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "concurrently -k -n WEB,API,AGENT \"vite --host 0.0.0.0\" \"node server/index.mjs\" \"node agent/index.mjs\"",
    "agent": "node agent/index.mjs",
    "kiosk": "node kiosk/launcher.mjs",
    "kiosk:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-kiosk-autostart.ps1",
    "kiosk:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-kiosk-autostart.ps1 -Remove",
    "start": "node server/index.mjs",
    "supabase:login": "supabase login",
    "supabase:link": "supabase link --project-ref cykevgvpgpzormkhfmmd",
    "supabase:push": "supabase db push --linked",
    "test:api": "node scripts/api-check.mjs",
    "test:supabase": "node scripts/supabase-check.mjs",
    "test:responsive": "node scripts/responsive-check.mjs",
    "typecheck": "tsc --noEmit"
  },
