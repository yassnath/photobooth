# Core server
VITE_PORT=5173
API_PORT=4174
PUBLIC_APP_URL=https://photo.example.com
SESSION_PRICE=25000
DATABASE_DRIVER=sqlite
DATABASE_URL=
DATABASE_SSL=true
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-long-password
ADMIN_BOOTSTRAP_NAME=Booth Admin
ADMIN_SESSION_HOURS=12

# Supabase project. Keep the service-role key server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=photobooth-media
SUPABASE_DIRECT_URL=

# Payment: use mock until Midtrans sandbox credentials are ready
PAYMENT_PROVIDER=mock
PAYMENT_EXPIRY_MINUTES=10
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_QRIS_ACQUIRER=gopay

# Storage: local, s3, or supabase (service-role key required)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=ap-southeast-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
RESULT_RETENTION_HOURS=24
RAW_PHOTO_RETENTION_HOURS=72

# Booth and local agent
BOOTH_ID=booth-main
BOOTH_NAME=Main Booth
BOOTH_AGENT_TOKEN=replace-with-a-random-agent-token
PRINTER_AGENT_PORT=4175
PRINTER_NAME=
PRINTER_MODE=spool
PHOTOBOOTH_API_URL=http://127.0.0.1:4174
VITE_PRINTER_AGENT_URL=http://127.0.0.1:4175
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
